# Copy to CMS/.env. This file is gitignored; the values never leave your machine.
#
# Shopify Admin API (custom app, see docs/SHOPIFY-SETUP.md). Needed only for
# "Sync to Shopify"; everything else in the CMS works without it.
SHOPIFY_STORE_DOMAIN=
SHOPIFY_ADMIN_TOKEN=
# Optional: inventory location to write stock levels to (shown in the Shopify panel).
SHOPIFY_LOCATION_ID=
# Optional: comma-separated sales channel names to publish products to.
SHOPIFY_PUBLICATIONS=Online Store,Headless

# CMS server
PORT=3000
HOST=127.0.0.1
