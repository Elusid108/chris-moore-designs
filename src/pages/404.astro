---
import Base from '../layouts/Base.astro';
---
<Base title="Not found" description="That page does not exist.">
  <section class="pt-24 pb-32 container mx-auto px-4 sm:px-6 text-center">
    <p class="font-mono text-xs uppercase tracking-widest text-brand-accent mb-2">404</p>
    <h1 class="text-4xl md:text-6xl font-extrabold tracking-tight">Nothing on this output.</h1>
    <p class="text-brand-text-muted mt-4">The page you asked for isn’t here. Try the shop or search.</p>
    <div class="mt-8 flex justify-center gap-4"><a href="/" class="px-6 py-3 bg-white text-black font-bold rounded-lg hover:bg-brand-accent transition-colors">Back to the shop</a><a href="/search/" class="px-6 py-3 border border-brand-border-strong rounded-lg hover:bg-brand-surface transition-colors">Search</a></div>
  </section>
</Base>
