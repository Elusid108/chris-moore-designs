---
import Base from '../layouts/Base.astro';
import ProductHero from '../components/ProductHero.astro';
import ProductShelf from '../components/ProductShelf.astro';
import SupportStrip from '../components/SupportStrip.astro';
import ServiceCards from '../components/ServiceCards.astro';
import { getCatalog, pick } from '../lib/content';

const c = await getCatalog();
const { home } = c.settings;
const hero = c.productById.get(home.heroProduct) || c.products[0];
const pillProducts = pick(c.productById, home.heroVariantsFrom?.length ? home.heroVariantsFrom : [hero.id]);
const pills = pillProducts.flatMap((p) => p.variants.map((v) => ({ label: p.variants.length > 1 ? `${v.title}` : v.title === 'Default Title' ? p.title : v.title, product: p, variant: v })));
const shelf = home.shelf?.length ? pick(c.productById, home.shelf) : c.products;
const family = c.familyById.get(hero.family);
---
<Base title="Home">
  <ProductHero product={hero} familyName={`${family?.name || ''} · ${family?.category || 'hardware'}`} pills={pills} headingLevel="h1" linkTitle />
  <ProductShelf products={shelf} title={home.shelfTitle || 'Boards, controllers, bundles'} filters={home.shelfFilters} />
  <SupportStrip />
  <ServiceCards services={c.services} />
</Base>
