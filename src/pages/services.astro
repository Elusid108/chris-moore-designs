---
import { getCatalog, pick } from '../lib/content';
import Base from '../layouts/Base.astro';
import ServiceCards from '../components/ServiceCards.astro';
const c = await getCatalog();
const tools = c.services.flatMap((s) => pick(c.softwareById, s.relatedApps).map((a) => ({ service: s, app: a })));
---
<Base title="Services" description="Custom color lithophanes, PCBA design and install commissioning.">
  <section class="pt-12 pb-4 container mx-auto px-4 sm:px-6">
    <p class="font-mono text-xs uppercase tracking-widest text-brand-accent mb-2">Services</p>
    <h1 class="text-4xl md:text-5xl font-extrabold tracking-tight">Made to order</h1>
    <p class="text-brand-text-muted mt-3 max-w-prose">Quotes by email. Lithophanes: supply a photo at least 2,000 px on the long edge and expect 5–7 business days.</p>
  </section>
  <ServiceCards services={c.services} title="What I make" eyebrow="Services" withDescription />
  {tools.length > 0 && (
    <section class="py-12 container mx-auto px-4 sm:px-6">
      <p class="font-mono text-xs uppercase tracking-widest text-brand-accent mb-4">Free tools used for these</p>
      <ul class="grid sm:grid-cols-3 gap-4">{tools.map(({ app }) => <li class="rounded-xl bg-brand-surface border border-brand-border p-4"><a href={app.appUrl || `/software/#${app.slug}`} class="font-bold hover:text-brand-accent">{app.name} ↗</a><p class="text-sm text-brand-text-muted mt-1">{app.summary}</p></li>)}</ul>
    </section>
  )}
</Base>
