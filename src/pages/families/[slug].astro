---
import { getCatalog } from '../../lib/content';
import Base from '../../layouts/Base.astro';
import ProductShelf from '../../components/ProductShelf.astro';

export async function getStaticPaths() {
  const c = await getCatalog();
  return c.families.map((f) => ({ params: { slug: f.slug }, props: { id: f.id } }));
}
const c = await getCatalog();
const f = c.familyById.get(Astro.props.id)!;
const products = c.products.filter((p) => p.family === f.id);
const hero = f.heroImage;
---
<Base title={f.name} description={f.tagline} image={`/og/family-${f.slug}.jpg`}>
  <section class="container mx-auto px-4 sm:px-6 pt-10 pb-6 grid lg:grid-cols-2 gap-8 items-center">
    <div>
      <p class="font-mono text-xs uppercase tracking-widest text-brand-accent">{f.category} · product family</p>
      <h1 class="text-4xl md:text-6xl font-extrabold tracking-tight mt-2">{f.name}</h1>
      <p class="text-brand-text-muted text-lg mt-4">{f.tagline}</p>
      {f.description && <div class="prose-html mt-4 text-brand-text-muted" set:html={f.description} />}
      {f.portfolioSlug && <a class="mt-4 inline-block text-xs uppercase tracking-wide text-brand-accent hover:underline" href={`${c.settings.site.portfolioUrl}/projects/${f.portfolioSlug}/`}>See it in the portfolio ↗</a>}
    </div>
    <div class="aspect-[4/3] rounded-2xl border border-brand-border overflow-hidden bg-black">
      {hero ? <img src={hero.hero || hero.url} alt={hero.alt || f.name} class="w-full h-full object-cover" loading="eager" /> : <div class="w-full h-full render-placeholder" role="img" aria-label={`${f.name} (image coming soon)`}></div>}
    </div>
  </section>
  <ProductShelf products={products} title={`${f.name} products`} eyebrow="Shop" id="products" />
</Base>
