---
import type { Service } from '../lib/content';
import { money } from '../lib/content';
import { SETTINGS } from '../lib/store-config';
interface Props { services: Service[]; title?: string; eyebrow?: string; withDescription?: boolean }
const { services, title = SETTINGS.home.servicesTitle || 'Services', eyebrow = 'Made to order', withDescription = false } = Astro.props;
---
<section id="services" class="py-14 border-t border-zinc-900 bg-black">
  <div class="container mx-auto px-4 sm:px-6">
    <p class="font-mono text-xs uppercase tracking-widest text-brand-accent">{eyebrow}</p>
    <h2 class="text-2xl md:text-3xl font-bold mt-1 mb-6">{title}</h2>
    <div class="grid md:grid-cols-3 gap-4">
      {services.map((s) => (
        <article id={s.slug} class="rounded-xl bg-brand-surface border border-brand-border p-5 flex flex-col scroll-mt-24">
          <h3 class="font-bold">{s.name}</h3>
          <p class="text-sm text-brand-text-muted mt-2">{s.summary}</p>
          {withDescription && s.description && <div class="text-sm text-brand-text-muted mt-2 prose-html" set:html={s.description} />}
          <div class="mt-4 pt-2 flex items-center justify-between gap-3 mt-auto">
            <span class="font-mono text-sm text-brand-text">{s.startingPrice != null ? `from ${money(s.startingPrice)}` : 'By quote'}</span>
            <a href={s.quoteUrl || SETTINGS.site.quoteUrl} class="px-4 py-2 border border-brand-border-strong rounded-lg text-sm hover:border-brand-accent hover:text-white transition-colors">Request quote</a>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
