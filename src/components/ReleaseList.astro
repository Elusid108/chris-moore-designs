---
import type { Firmware, Product } from '../lib/content';
import Icon from './Icon.astro';
interface Props { releases: Firmware[]; productById: Map<string, Product> }
const { releases, productById } = Astro.props;
---
<ol class="space-y-6">
  {releases.map((r) => (
    <li id={r.slug} class="rounded-xl bg-brand-surface border border-brand-border p-5 scroll-mt-24">
      <div class="flex flex-wrap items-baseline gap-x-4 gap-y-1">
        <h3 class="font-bold">{r.name}</h3>
        <span class="font-mono text-brand-accent text-sm">v{r.version}</span>
        <time class="font-mono text-xs text-brand-text-muted" datetime={r.date}>{r.date}</time>
        {r.ota && <span class="text-[10px] font-mono uppercase px-2 py-0.5 rounded bg-brand-secondary-strong text-white">OTA</span>}
      </div>
      <div class="mt-1 flex flex-wrap gap-2">
        {r.targets.map((id) => { const p = productById.get(id); return p ? <a href={`/products/${p.slug}/`} class="text-[10px] font-mono uppercase px-2 py-0.5 rounded bg-brand-surface-raised text-brand-accent border border-cyan-500/30 hover:border-brand-accent">{p.sku}</a> : null; })}
      </div>
      {r.notes && <div class="prose-html mt-3 text-sm text-brand-text-muted" set:html={r.notes} />}
      <div class="mt-4 flex flex-wrap gap-4 text-xs uppercase tracking-wide font-medium">
        {r.webInstallerManifest && <a class="text-brand-accent hover:underline inline-flex items-center gap-1" href={r.webInstallerManifest}><Icon name="bolt" size={14} /> Flash via web installer</a>}
        {(r.file?.url || r.downloadUrl) && <a class="text-brand-text-muted hover:text-white inline-flex items-center gap-1" href={r.file?.url || r.downloadUrl!} rel="noopener"><Icon name="download" size={14} /> Download</a>}
        {r.repo && <a class="text-brand-text-muted hover:text-white inline-flex items-center gap-1" href={r.repo} rel="noopener"><Icon name="external" size={14} /> Source</a>}
      </div>
      {r.sha256 && <p class="mt-2 font-mono text-[10px] text-brand-text-subtle break-all">sha256 {r.sha256}</p>}
    </li>
  ))}
</ol>
