---
import { SETTINGS } from '../lib/store-config';
import { getCatalog } from '../lib/content';
import Icon from './Icon.astro';
const c = await getCatalog();
const items = SETTINGS.home.supportStrip.map((it) => {
  const fw = it.ref && 'firmware' in it.ref && it.ref.firmware ? c.firmwareById.get(it.ref.firmware) : null;
  const sw = it.ref && 'software' in it.ref && (it.ref as any).software ? c.softwareById.get((it.ref as any).software) : null;
  return { ...it, version: fw?.version || sw?.version || null, href: it.href || (fw ? '/firmware/' : sw ? '/software/' : '#') };
});
const color: Record<string, string> = { accent: 'text-brand-accent', secondary: 'text-brand-secondary', hardware: 'text-cat-hardware' };
---
{items.length > 0 && (
<section id="support" class="py-12 border-t border-zinc-900">
  <div class="container mx-auto px-4 sm:px-6">
    <p class="font-mono text-xs uppercase tracking-widest text-brand-accent mb-4">Included with every board</p>
    <div class="grid sm:grid-cols-3 gap-4">
      {items.map((it) => (
        <div class="rounded-xl bg-brand-surface border border-brand-border p-5 flex gap-4">
          <Icon name={it.icon} size={24} class={`${color[it.color] || 'text-brand-accent'} shrink-0`} />
          <div>
            <h3 class="font-bold">{it.title}{it.version && <span class="font-mono text-brand-accent text-xs ml-1.5">v{it.version}</span>}</h3>
            <p class="text-sm text-brand-text-muted mt-1">{it.text}</p>
            <a href={it.href} class="text-xs uppercase tracking-wide text-brand-secondary hover:underline mt-2 inline-block">{it.linkLabel}</a>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
)}
